{
  "name": "@shlinkio/data-manipulation",
  "description": "Userland implementations of some data manipulation helpers extracted from ramda",
  "private": false,
  "repository": "https://github.com/shlinkio/data-manipulation",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:ci": "node --run test -- --coverage",
    "cs": "node --run lint && node --run format:check",
    "cs:fix": "node --run lint:fix && node --run format",
    "lint": "oxlint src ./·config.ts",
    "lint:fix": "node --run lint -- --fix",
    "format": "oxfmt src ./·config.ts",
    "format:check": "node --run format -- --check",
    "types": "tsc --noEmit"
  },
  "devDependencies": {
    "@shlinkio/eslint-config-js-coding-standard": "~4.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.0.3"
  }
}
